<Window x:Class="BimPrefabExport.UI.SyncConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senkronizasyon çakışması"
        Height="260"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6F9">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="MessageText"
               Grid.Row="0"
               TextWrapping="Wrap"
               FontSize="13"
               Foreground="#123A5C"
               Margin="0,0,0,12" />

    <TextBlock Grid.Row="1"
               TextWrapping="Wrap"
               Foreground="#445566"
               FontSize="12"
               Text="Aynı ürün hem AutoCAD'de hem sunucuda değiştirilmiş. Hangi sürümü kullanmak istersiniz?" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="UseServerButton" Content="Sunucuyu kullan" Width="130" Height="30" Margin="0,0,8,0" Click="OnUseServer" />
      <Button x:Name="UseLocalButton" Content="Yereli kullan" Width="110" Height="30" Margin="0,0,8,0" Click="OnUseLocal" />
      <Button Content="Atla" Width="70" Height="30" IsCancel="True" Click="OnSkip" />
    </StackPanel>
  </Grid>
</Window>
