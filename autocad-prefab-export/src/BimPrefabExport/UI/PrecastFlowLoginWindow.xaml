<Window x:Class="BimPrefabExport.UI.PrecastFlowLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrecastFlow — Giriş"
        Height="420"
        Width="480"
        MinHeight="380"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6F9">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="PrecastFlow Sunucu Bağlantısı"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="#123A5C"
               Margin="0,0,0,4" />
    <TextBlock Grid.Row="1"
               TextWrapping="Wrap"
               Foreground="#445566"
               FontSize="12"
               Margin="0,0,0,16"
               Text="AutoCAD ürünlerinizi sunucuya kaydetmek ve sunucudan güncellemek için giriş yapın. Parallels ortamında Mac IP adresini kullanın (ör. http://10.211.55.2:5255)." />

    <StackPanel Grid.Row="2">
      <TextBlock Text="API adresi" Margin="0,0,0,4" Foreground="#123A5C" />
      <TextBox x:Name="ApiUrlBox" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" />

      <TextBlock Text="E-posta" Margin="0,0,0,4" Foreground="#123A5C" />
      <TextBox x:Name="EmailBox" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" />

      <TextBlock Text="Şifre" Margin="0,0,0,4" Foreground="#123A5C" />
      <PasswordBox x:Name="PasswordBox" Height="28" Margin="0,0,0,10" VerticalContentAlignment="Center" />

      <TextBlock x:Name="StatusText"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="#323232"
                 Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,8">
      <Button x:Name="TestButton" Content="Bağlantıyı test et" Width="130" Height="30" Margin="0,0,8,0" Click="OnTestClick" />
      <Button x:Name="LoginButton" Content="Giriş yap" Width="100" Height="30" IsDefault="True" Click="OnLoginClick" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="İptal" Width="80" Height="30" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
